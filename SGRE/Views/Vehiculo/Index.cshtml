@model IEnumerable<SGRE.Domain.Entities.Vehiculo>

@{
    ViewBag.Title = "Vehículos";
}

<h2>Vehículos</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Registrar nuevo vehículo", "Crear", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Placa</th>
            <th>Tipo</th>
            <th>Capacidad</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vehiculo in Model)
        {
            <tr>
                <td>@vehiculo.Id</td>
                <td>@vehiculo.Placa</td>
                <td>@vehiculo.Tipo</td>
                <td>@vehiculo.Capacidad</td>
            </tr>
        }
    </tbody>
</table>