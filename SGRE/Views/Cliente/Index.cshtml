@model IEnumerable<SGRE.Domain.Entities.Cliente>

@{
    ViewBag.Title = "Clientes";
}

<h2>Clientes</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">@TempData["Mensaje"]</div>
}

<p>@Html.ActionLink("Registrar nuevo cliente", "Crear", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>RFC</th>
            <th>Teléfono</th>
            <th>Dirección</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Id</td>
                <td>@cliente.Nombre</td>
                <td>@cliente.RFC</td>
                <td>@cliente.Telefono</td>
                <td>@cliente.Direccion</td>
                <td>@Html.ActionLink("Editar", "Editar", new { id = cliente.Id })</td>
            </tr>
        }
    </tbody>
</table>