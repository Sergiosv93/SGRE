@model SGRE.Domain.Entities.Cliente

@{
    ViewBag.Title = "Registrar cliente";
}

<h2>Registrar nuevo cliente</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Nombre</label>
        @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>RFC</label>
        @Html.TextBoxFor(m => m.RFC, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Teléfono</label>
        @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Dirección</label>
        @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Registrar</button>
}