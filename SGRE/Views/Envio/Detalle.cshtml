@model SGRE.Domain.Entities.Envio

@{
    ViewBag.Title = "Detalle del envío";
}

<h2>Envío #@Model.Id</h2>

<dl class="dl-horizontal">
    <dt>Cliente</dt>
    <dd>@(Model.Cliente?.Nombre)</dd>

    <dt>Origen</dt>
    <dd>@Model.OrigenDireccion</dd>

    <dt>Destino</dt>
    <dd>@Model.DestinoDireccion</dd>

    <dt>Estatus actual</dt>
    <dd><strong>@Model.Estatus</strong></dd>

    <dt>Fecha creación</dt>
    <dd>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

@using (Html.BeginForm("CambiarEstatus", "Envio"))
{
    @Html.AntiForgeryToken()
    @Html.Hidden("envioId", Model.Id)

    <div class="form-group">
        <label>Cambiar estatus a:</label>
        @Html.DropDownList("nuevoEstatus", new SelectList(Enum.GetValues(typeof(SGRE.Domain.Enums.EstatusEnvio))), new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Comentario</label>
        <textarea name="comentario" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-warning">Actualizar estatus</button>
}

<hr />
<h4>Evidencia de entrega</h4>

@if (ViewBag.Evidencia != null)
{
    var evidencia = (SGRE.Domain.Documents.EvidenciaEntrega)ViewBag.Evidencia;
    <p><strong>Notas:</strong> @evidencia.Notas</p>
    <p><strong>Fecha:</strong> @evidencia.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
}
else
{
    using (Html.BeginForm("RegistrarEvidencia", "Envio"))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("envioId", Model.Id)

        <div class="form-group">
            <label>Notas de entrega</label>
            <textarea name="notas" class="form-control"></textarea>
        </div>

        <button type="submit" class="btn btn-info">Registrar evidencia</button>
    }
}