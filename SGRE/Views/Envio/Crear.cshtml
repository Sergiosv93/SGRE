@model SGRE.Domain.Entities.Envio

@{
    ViewBag.Title = "Registrar envío";
}

<h2>Registrar nuevo envío</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label>Cliente</label>
        @Html.DropDownList("ClienteId", (SelectList)ViewBag.Clientes, "-- Seleccione --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Chofer</label>
        @Html.DropDownList("ChoferId", (SelectList)ViewBag.Choferes, "-- Seleccione --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Vehículo</label>
        @Html.DropDownList("VehiculoId", (SelectList)ViewBag.Vehiculos, "-- Seleccione --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Dirección de origen</label>
        @Html.TextBoxFor(m => m.OrigenDireccion, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Dirección de destino</label>
        @Html.TextBoxFor(m => m.DestinoDireccion, new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Registrar envío</button>
}